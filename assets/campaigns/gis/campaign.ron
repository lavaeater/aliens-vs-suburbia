// The GIS campaign: one OpenStreetMap import (`world/world.map`, from
// assets/osm/map-01.osm.ron) cut into levels with the campaign editor
// (cargo run -- --campaign-editor gis). The default campaign (`campaign::DEFAULT_CAMPAIGN`).
// Placeholder texts. Plain ASCII only.
(
    base: "campaigns/gis/world/world.map",
    levels: [
        (
            map: "campaigns/gis/map_01/map_01.map",
            title: "Är detta Salems öde?",
            tagline: "Ingen kunde berätta varför vi behövde skyddsutrustningen",
        ),
        (
            map: "campaigns/gis/gis_02/gis_02.map",
            title: "The Blocks",
            tagline: "Placeholder: the same town, further north.",
        ),
        (
            map: "campaigns/gis/gis_03/gis_03.map",
            title: "Fire Down Below",
            tagline: "Placeholder: grenade launchers, and houses that burn.",
        ),
        (
            map: "campaigns/gis/gis_04/gis_04.map",
            title: "The Long Road",
            tagline: "Placeholder: 300 coins of towers against everything.",
        ),
        (
            map: "campaigns/gis/gis_05/gis_05.map",
            title: "The Whole Town",
            tagline: "Placeholder: they are everywhere now.",
        ),
    ],
    victory_title: "THE TOWN IS HELD",
    victory_lines: [
        "Placeholder: the last spawner gutters out behind the shopping centre.",
        "The neighbourhood goes back to arguing about parking.",
    ],
    // The copter ride in before level 1 (src/intro, docs/intro.md). Every field may be
    // left out. `music` is played once over it (mp3/ogg/wav, inside assets/); `timing` is
    // seconds per part, to fit the track; `copter.model` empty = the built-in stand-in.
    intro: Some((
        music: "music/intro.mp3",
        music_db: 0.0,
        copter: (
            model: "new-models/drone.glb",
            scale: 15.0,
            turn_degrees: 0.0,
            rotors: [(node: "Rotor_BL"), (node: "Rotor_FL"), (node: "Rotor_BR"), (node: "Rotor_FR")],
        ),
        timing: (dive: 10.0, low_pass: 9.0, flare: 4.0, rappel: 5.0, handoff: 3.0),
        clouds: (base: 70.0, top: 115.0),
    )),
)
