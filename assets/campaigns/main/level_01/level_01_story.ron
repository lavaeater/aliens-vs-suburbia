// Level 1's own stories, loaded on top of the base level-flow ones (`MapFile::stories`).
// Format: see turbofacts/assets/stories/example.ron. Crawls: `Emit(effect: "crawl:<name>")`
// shows the crawl of that name (its file stem, e.g. level_01_crawl_intro.ron in this
// folder), and sets `CrawlFinished.<name>` when it is done.
// A story item (`Key(id: "letter")`) sets `ItemFound.letter` when picked up.
[
    (
        name: "Level 1 intro",
        repeat: false,
        init_facts: [
            ("ObjectiveText", Text("Hold Maple Drive. Do not let 10 of them reach the end of the road")),
        ],
        rules: [
            (name: "started", criteria: [BoolIs(key: "LevelStarted", expected: true)]),
        ],
        consequences: [Emit(effect: "crawl:level_01_crawl_intro")],
    ),
    (
        name: "The strange letter",
        repeat: false,
        rules: [
            (name: "found it", criteria: [BoolIs(key: "ItemFound.letter", expected: true)]),
        ],
        consequences: [
            Emit(effect: "crawl:level_01_crawl_strange_letter"),
            SetFact(key: "ObjectiveText", value: Text("Hold Maple Drive - then off to the community centre")),
        ],
    ),
    (
        name: "Level 1 outro",
        repeat: false,
        rules: [
            (
                name: "won",
                criteria: [
                    BoolIs(key: "LevelComplete", expected: true),
                    BoolIs(key: "LevelFailed", expected: false),
                ],
            ),
        ],
        consequences: [Emit(effect: "crawl:level_01_crawl_outro")],
    ),
]
