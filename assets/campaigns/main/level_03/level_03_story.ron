// Level 3's stories: a snow day. Snowballs only (`weapons:` in the map), coins for towers.
[
    (
        name: "Level 3 intro",
        repeat: false,
        init_facts: [
            ("ObjectiveText", Text("Snowballs only! Build towers (B) along the path. Do not let 8 through")),
        ],
        rules: [
            (name: "started", criteria: [BoolIs(key: "LevelStarted", expected: true)]),
        ],
        consequences: [Emit(effect: "crawl:level_03_crawl_intro")],
    ),
    (
        name: "Halfway",
        repeat: false,
        rules: [(name: "third wave", criteria: [IntCmp(key: "CurrentWave", op: Eq, value: 2)])],
        consequences: [
            Emit(effect: "crawl:level_03_crawl_dinner"),
            SetFact(key: "ObjectiveText", value: Text("Hold the line until dinner")),
        ],
    ),
    (
        name: "The big ones",
        repeat: false,
        rules: [(name: "last wave", criteria: [IntCmp(key: "CurrentWave", op: Eq, value: 4)])],
        consequences: [
            SetFact(key: "ObjectiveText", value: Text("Exploding alpacas! Keep your distance")),
        ],
    ),
    (
        name: "Level 3 outro",
        repeat: false,
        rules: [
            (
                name: "won",
                criteria: [
                    BoolIs(key: "LevelComplete", expected: true),
                    BoolIs(key: "LevelFailed", expected: false),
                ],
            ),
        ],
        consequences: [Emit(effect: "crawl:level_03_crawl_outro")],
    ),
]
