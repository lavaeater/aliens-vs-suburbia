// Smoke over a fire. Loops with a `gore::fire::FireField` (and its flames); grey puffs
// that rise, swell, drift a little downwind and thin out. Not one-shot: `fx::StopFx`
// ends it once the last puff is gone.
// Edit with the sprinkles editor (`cargo install bevy_sprinkles_editor`) or by hand;
// `every_fx_in_assets_parses` checks the file.
(
    sprinkles_version: "0.3",
    name: "Smoke",
    dimension: D3,
    despawn_on_finish: false,
    emitters: [
        (
            name: "Puffs",
            time: (
                lifetime: 3.2,
                lifetime_randomness: 0.35,
            ),
            draw_pass: (
                mesh: Sphere(radius: 0.5, segments: 6, rings: 4),
                material: Standard((
                    base_color: (1.0, 1.0, 1.0, 1.0),
                    emissive: (0.0, 0.0, 0.0, 1.0),
                    alpha_mode: Opaque,
                    unlit: true,
                )),
                shadow_caster: false,
            ),
            emission: (
                shape: Box(extents: (0.5, 0.05, 0.5)),
                particles_amount: 14,
            ),
            scale: (
                range: (min: 0.25, max: 0.45),
                scale_over_lifetime: Some((
                    x: (
                        points: [
                            (position: 0.0, value: 0.3),
                            (position: 0.35, value: 1.0),
                            (position: 0.8, value: 0.9),
                            (position: 1.0, value: 0.0),
                        ],
                        range: (min: 0.0, max: 1.0),
                    ),
                )),
            ),
            colors: (
                color_over_lifetime: (
                    stops: [
                        (color: (0.12, 0.11, 0.1, 1.0), position: 0.0),
                        (color: (0.28, 0.27, 0.26, 1.0), position: 0.5),
                        (color: (0.42, 0.42, 0.42, 1.0), position: 1.0),
                    ],
                ),
            ),
            velocities: (
                initial_direction: (0.0, 1.0, 0.0),
                spread: 12.0,
                initial_velocity: (min: 0.5, max: 0.9),
            ),
            accelerations: (
                // Up, and a breeze from the west.
                gravity: (0.25, 0.35, 0.08),
            ),
        ),
    ],
)
