// A burning house's smoke: a thick dark column off the roof, leaning downwind. Loops
// while `gore::house_fire` burns; `fx::StopFx` ends it.
// Edit with the sprinkles editor (`cargo install bevy_sprinkles_editor`) or by hand;
// `every_fx_in_assets_parses` checks the file.
(
    sprinkles_version: "0.3",
    name: "Smoke column",
    dimension: D3,
    despawn_on_finish: false,
    emitters: [
        (
            name: "Column",
            time: (
                lifetime: 5.0,
                lifetime_randomness: 0.3,
            ),
            draw_pass: (
                mesh: Sphere(radius: 0.5, segments: 6, rings: 4),
                material: Standard((
                    base_color: (1.0, 1.0, 1.0, 1.0),
                    emissive: (0.0, 0.0, 0.0, 1.0),
                    alpha_mode: Opaque,
                    unlit: true,
                )),
                shadow_caster: false,
            ),
            emission: (
                shape: Box(extents: (0.8, 0.1, 0.8)),
                particles_amount: 30,
            ),
            scale: (
                range: (min: 0.35, max: 0.6),
                scale_over_lifetime: Some((
                    x: (
                        points: [
                            (position: 0.0, value: 0.35),
                            (position: 0.3, value: 1.0),
                            (position: 0.85, value: 1.2),
                            (position: 1.0, value: 0.0),
                        ],
                        range: (min: 0.0, max: 1.4),
                    ),
                )),
            ),
            colors: (
                color_over_lifetime: (
                    stops: [
                        (color: (0.07, 0.06, 0.06, 1.0), position: 0.0),
                        (color: (0.16, 0.15, 0.15, 1.0), position: 0.5),
                        (color: (0.3, 0.3, 0.31, 1.0), position: 1.0),
                    ],
                ),
            ),
            velocities: (
                initial_direction: (0.0, 1.0, 0.0),
                spread: 10.0,
                initial_velocity: (min: 0.8, max: 1.3),
            ),
            accelerations: (
                gravity: (0.35, 0.3, 0.12),
            ),
        ),
    ],
)
