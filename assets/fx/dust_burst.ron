// Dust burst. A structure crumbling (`gore::terrain`), under the rubble chunks.
// Edit with the sprinkles editor (`cargo install bevy_sprinkles_editor`) or by hand;
// `every_fx_in_assets_parses` checks the file.
(
    sprinkles_version: "0.3",
    name: "Dust burst",
    dimension: D3,
    despawn_on_finish: true,
    emitters: [
        (
            name: "Dust",
            time: (
                lifetime: 0.9,
                lifetime_randomness: 0.3,
                one_shot: true,
                explosiveness: 1.0,
            ),
            draw_pass: (
                mesh: Sphere(radius: 0.5, segments: 6, rings: 4),
                material: Standard((
                    base_color: (0.45, 0.42, 0.38, 1.0),
                    emissive: (0.0, 0.0, 0.0, 1.0),
                    alpha_mode: Opaque,
                    unlit: true,
                )),
                shadow_caster: false,
            ),
            emission: (
                shape: Sphere(radius: 0.4),
                particles_amount: 12,
            ),
            scale: (
                range: (min: 0.2, max: 0.4),
                scale_over_lifetime: Some((
                    x: (
                        points: [
                            (position: 0.0, value: 0.5),
                            (position: 0.3, value: 1.0),
                            (position: 1.0, value: 0.0),
                        ],
                        range: (min: 0.0, max: 1.0),
                    ),
                )),
            ),
            velocities: (
                initial_direction: (0.0, 1.0, 0.0),
                spread: 80.0,
                initial_velocity: (min: 0.5, max: 1.5),
            ),
            accelerations: (
                gravity: (0.0, -0.5, 0.0),
            ),
        ),
    ],
)
